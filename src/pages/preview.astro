<body data-time="past">
  <header class="site"><div class="wrap bar">
    <a class="brand" href="/">Fret<b>work</b></a>
    <nav class="navlinks" id="navlinks"><a href="#how">How it works</a><a href="#what">What we do</a><a href="#pricing">Pricing</a><a href="/start">Start</a><a class="btn btn-acc" href="#" data-open-form>Book a call</a></nav><button class="navtoggle" type="button" aria-label="Open menu" aria-controls="navlinks" aria-expanded="false"><span></span><span></span><span></span></button>
