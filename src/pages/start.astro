---
import '../styles/global.css';
import { firm, steps, footerLine } from '../data/site.js';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Start — Fretwork</title>
  <meta name="description" content="Book a free systems audit. Describe one workflow that's costing your team time and we'll show you the highest-leverage fixes. No obligation." />
  <link rel="canonical" href="https://www.fretworksystems.com/start" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Fretwork Systems" />
  <meta property="og:title" content="Start — Fretwork Systems" />
  <meta property="og:description" content="Book a free systems audit. Describe one workflow costing your team time and we'll show you the highest-leverage fixes. No obligation." />
  <meta property="og:image" content="https://www.fretworksystems.com/og-fretwork.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://www.fretworksystems.com/start" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Start — Fretwork Systems" />
  <meta name="twitter:description" content="Book a free systems audit. No obligation." />
  <meta name="twitter:image" content="https://www.fretworksystems.com/og-fretwork.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments);};var gtag=window.gtag;
    gtag('js',new Date());gtag('config','AW-18371546487');gtag('config','G-B2NDY58EKD',{linker:{domains:['vaulthuman.com','tercetlaw.com','fretworksystems.com','triplicityadvisory.com','csh-vault.com']}});
    (function(){var fired=false;function fire(){if(fired)return;fired=true;gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});gtag('event','generate_lead');}
    window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;if(typeof d==='string'){try{d=JSON.parse(d);}catch(_){return;}}if(!d||typeof d!=='object')return;var t=d.type||d.messageType||'',n=d.eventName||d.event||'';if(t==='hsFormCallback'&&(n==='onFormSubmitted'||n==='onFormSubmit'))fire();else if(n==='onFormSubmitted')fire();else if(d.accepted===true&&d.formGuid)fire();});
    window.addEventListener('hsFormCallback',function(e){if(e&&e.detail&&e.detail.eventName==='onFormSubmitted')fire();});})();
  </script>
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">{firm.wordmark}</a>
      <a class="navbtn" href="/">Back to site</a>
    </div>
  </header>
  <main>
    <div class="wrap">
      <div class="pagehead">
        <p class="eyebrow">Book a free systems audit</p>
        <h1>Start with a free audit.</h1>
        <p class="dek">Describe one workflow that&rsquo;s costing your team time &mdash; we&rsquo;ll review it personally and show you the highest-leverage fixes. No obligation.</p>
      </div>
      <hr class="rule" />
      <h2 class="sec">What happens next</h2>
      <ol class="steps">{steps.map((s) => (<li><span class="rn">{s.n}</span><b>{s.title}</b> {s.body}</li>))}</ol>
      <hr class="rule" />
      <p class="pricenote"><b>Fixed scope, fixed price.</b> The audit is free. Build sprints are quoted in writing before any work begins &mdash; no retainers, no surprises.</p>
      <p class="proofline">Built by Russ Michaels &mdash; twenty years running organizations, now connecting the tools lean teams already own. Every build is human-reviewed before hand-off.</p>
      <div class="formwrap">
        <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
        <div class="hs-form-frame" data-region="na2" data-form-id="3f225ab5-5a70-46d9-a497-29e6256b1e52" data-portal-id="246947446"></div>
      </div>
      <p class="note">Share one workflow that&rsquo;s slowing your team down and we&rsquo;ll reply personally &mdash; usually within one business day. A real person holds it from here.</p>
    </div>
  </main>
  <footer class="site">
    <div class="wrap">
      <p class="sig">{firm.legalName.toUpperCase()}</p>
      <p class="meta">{footerLine} &middot; <a href="tel:+18888332510">(888)&nbsp;833-2510</a> &middot; &copy; {year}</p>
      <p class="backlink">A member of the <a href="https://www.vaulthuman.com">Vault Human</a> family of companies.</p>
    </div>
  </footer>
  <style>
    .pagehead{padding:56px 0 8px;text-align:center;}
    .pagehead h1{margin:14px 0 18px;}
    .eyebrow{font-family:var(--sans);font-weight:500;font-size:12px;letter-spacing:3px;text-transform:uppercase;}
    .dek{max-width:680px;margin:0 auto;font-family:var(--serif);font-size:clamp(17px,2vw,20px);line-height:1.5;}
    .formwrap{background:#f7f5f0;color:#14161c;border:1px solid #e4ded3;border-radius:14px;padding:26px 22px;margin:10px auto 20px;max-width:560px;min-height:360px;box-shadow:0 20px 40px rgba(0,0,0,.28);}
    .formwrap :is(label,legend,p,span,h1,h2,h3){color:#14161c !important}
    .formwrap :is(input,textarea,select){color:#14161c !important;background:#fff !important;border:1px solid #c9c4bb !important}
    .pricenote{max-width:680px;margin:16px auto 6px;text-align:center;font-size:16px}
    .proofline{max-width:680px;margin:0 auto 18px;text-align:center;font-size:14px;opacity:.8}
    .note{max-width:680px;margin:12px auto 60px;text-align:center;opacity:.8;font-size:14px;}
  </style>
</body>
</html>
