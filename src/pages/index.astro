<body>

<div class="util">// AI &amp; workflow systems for lean teams &nbsp;—&nbsp; <b>delivered remotely, across the U.S.</b></div>

<header><div class="wrap nav">
  <div class="brand">FRET<span>WORK</span></div>
  <nav class="navlinks">
    <a href="#build">What We Build</a>
    <a href="#method">Method</a>
    <a href="#pricing">Pricing</a>
    <a href="#book" class="btn btn-primary" style="padding:10px 20px" data-open-form>Book a Diagnostic</a>
  </nav>
</div></header>

<!-- HERO -->
<section class="hero"><div class="wrap hero-grid">
  <div>
    <div class="eyebrow">AI · Automation · Systems</div>
    <h1>Where all the moving parts finally <em>move as one.</em></h1>
    <p class="lede">We connect the tools, workflows, and AI your team already runs into one system that syncs and works &mdash; so your people get their hours back. Human sign-off on everything that ships.</p>
    <div class="hero-cta">
      <a href="#book" class="btn btn-primary" data-open-form>Book your AI Systems Diagnostic</a>
      <a href="#method" class="btn btn-ghost">See how it works</a>
    </div>
    <div class="hero-sig">// no rip-and-replace · no year-long engagement · built around how your people already work</div>
  </div>
  <div style="background:#14171D;border:1px solid #252A33;border-radius:12px;padding:30px 26px;max-width:330px;margin-left:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px">
