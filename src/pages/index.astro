<style is:global>
  :root{
    --bg:#0C0E12; --panel:#14171D; --panel-2:#191D25; --line:#252A33;
    --text:#E9ECF2; --muted:#9BA3B0; --dim:#6B7280;
    --accent:#CBA96A;      /* electric mint — "systems moving" */
    --accent-2:#C4C8CE;    /* cobalt secondary */
    --white:#fff;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased}
  h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif;font-weight:600;line-height:1.1;letter-spacing:-0.02em}
  h1{font-size:clamp(2.3rem,5vw,4.1rem)}
  h2{font-size:clamp(1.7rem,3.4vw,2.6rem)}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1160px;margin:0 auto;padding:0 26px}
  .mono{font-family:'JetBrains Mono',monospace;letter-spacing:.02em}
  .eyebrow{font-family:'JetBrains Mono',monospace;font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
  .btn{display:inline-block;padding:14px 28px;border-radius:4px;font-weight:600;font-size:.94rem;cursor:pointer;border:1.5px solid transparent;transition:.18s;font-family:'Space Grotesk'}
  .btn-primary{background:var(--accent);color:#1a1408}
  .btn-primary:hover{background:#DCC18C}
  .btn-ghost{background:transparent;color:var(--text);border-color:var(--line)}
  .btn-ghost:hover{border-color:var(--accent);color:var(--accent)}

  .util{background:#090A0D;color:var(--muted);font-family:'JetBrains Mono',monospace;font-size:.76rem;letter-spacing:.05em;text-align:center;padding:8px}
  .util b{color:var(--accent)}
  header{position:sticky;top:0;z-index:50;background:rgba(12,14,18,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:70px}
  .brand{font-family:'Space Grotesk';font-size:1.35rem;font-weight:700;letter-spacing:.02em}
  .brand span{color:var(--accent)}
  .navlinks{display:flex;gap:28px;align-items:center}
  .navlinks a{font-size:.9rem;color:var(--muted)}
  .navlinks a:hover{color:var(--text)}
  @media(max-width:860px){.navlinks a:not(.btn){display:none}}

  /* hero */
  .hero{padding:46px 0 44px}
  .hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:44px;align-items:center}
  .hero h1{margin:14px 0 16px}
  .hero h1 em{font-style:normal;color:var(--accent)}
  .hero .lede{font-size:1.12rem;color:var(--muted);max-width:40ch;margin-bottom:28px}
  .hero-cta{display:flex;gap:13px;flex-wrap:wrap}
  .hero-sig{margin-top:24px;font-family:'JetBrains Mono',monospace;font-size:.76rem;color:var(--dim)}
  @media(max-width:860px){.hero-grid{grid-template-columns:1fr;gap:34px}}

  /* workflow diagram */
  .diagram{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:26px}
  .diag-title{font-family:'JetBrains Mono';font-size:.72rem;color:var(--dim);letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}
  .tools{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
  .chip{font-family:'JetBrains Mono';font-size:.72rem;background:var(--panel-2);border:1px solid var(--line);border-radius:5px;padding:6px 10px;color:var(--muted)}
  .flowline{height:34px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.4rem}
  .hub{background:linear-gradient(135deg,rgba(203,169,106,.14),rgba(196,200,206,.10));border:1px solid var(--accent);border-radius:8px;padding:16px;text-align:center;margin:4px 0}
  .hub b{font-family:'Space Grotesk';font-size:1.05rem;color:var(--text)}
  .hub span{display:block;font-family:'JetBrains Mono';font-size:.7rem;color:var(--accent);margin-top:3px}
  .out{display:flex;justify-content:space-between;gap:8px;margin-top:8px}
  .out div{flex:1;background:var(--panel-2);border:1px solid var(--line);border-radius:6px;padding:10px;text-align:center;font-size:.74rem;color:var(--muted)}
  .out b{display:block;color:var(--accent);font-family:'JetBrains Mono';font-size:1.15rem}

  /* metrics */
  .metrics{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--panel)}
  .metrics .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}
  .metric{background:var(--panel);padding:34px 22px;text-align:center}
  .metric b{font-family:'Space Grotesk';font-size:2.3rem;color:var(--accent);display:block;line-height:1}
  .metric span{font-size:.86rem;color:var(--muted);display:block;margin-top:8px}
  .metrics .note{grid-column:1/-1;background:var(--bg);text-align:center;font-family:'JetBrains Mono';font-size:.68rem;color:var(--dim);padding:8px}
  @media(max-width:720px){.metrics .wrap{grid-template-columns:repeat(2,1fr)}}

  .band{padding:60px 0}
  .band-alt{background:var(--panel)}
  .sec-head{max-width:660px;margin-bottom:44px}
  .sec-head.center{margin-left:auto;margin-right:auto;text-align:center}
  .sec-head h2{margin:12px 0}
  .sec-head p{color:var(--muted)}

  /* problem */
  .problem p{font-size:1.25rem;color:var(--muted);max-width:60ch}
  .problem b{color:var(--text)}

  /* method */
  .method-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .mstep{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:24px;position:relative}
  .mstep .k{font-family:'JetBrains Mono';font-size:.72rem;color:var(--accent);margin-bottom:12px}
  .mstep h4{font-size:1.15rem;margin-bottom:6px;font-family:'Space Grotesk'}
  .mstep .when{font-family:'JetBrains Mono';font-size:.68rem;letter-spacing:.04em;color:var(--accent-2);margin-bottom:10px}
  .mstep p{font-size:.9rem;color:var(--muted)}
  .mstep .arrow{position:absolute;right:-11px;top:50%;color:var(--accent);z-index:2}
  .mstep:last-child .arrow{display:none}
  @media(max-width:860px){.method-steps{grid-template-columns:1fr 1fr}.mstep .arrow{display:none}}
  @media(max-width:520px){.method-steps{grid-template-columns:1fr}}

  /* offer ladder */
  .ladder{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
  .offer{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:28px;display:flex;flex-direction:column}
  .offer .tag{font-family:'JetBrains Mono';font-size:.7rem;color:var(--accent-2);letter-spacing:.08em;text-transform:uppercase}
  .offer h3{font-size:1.35rem;margin:8px 0 6px;font-family:'Space Grotesk'}
  .offer .price{font-family:'JetBrains Mono';font-size:1.25rem;color:var(--accent);margin:6px 0 12px}
  .offer p{font-size:.92rem;color:var(--muted);margin-bottom:14px}
  .offer ul{list-style:none;display:flex;flex-direction:column;gap:8px;font-size:.88rem;color:var(--text)}
  .offer li{padding-left:20px;position:relative}
  .offer li::before{content:"›";position:absolute;left:2px;color:var(--accent)}
  @media(max-width:720px){.ladder{grid-template-columns:1fr}}

  /* founder */
  .founder{display:grid;grid-template-columns:340px 1fr;gap:34px;align-items:start;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:34px}
  .founder img{width:100%;max-width:340px;aspect-ratio:4/5;object-fit:cover;object-position:50% 18%;border-radius:10px}
  .founder h3{font-size:1.4rem;margin-bottom:10px;font-family:'Space Grotesk'}
  .founder p{color:var(--muted);font-size:.96rem;margin-bottom:10px;max-width:60ch}
  .founder .role{font-family:'JetBrains Mono';font-size:.74rem;color:var(--accent);margin-bottom:14px}
  @media(max-width:640px){.founder{grid-template-columns:1fr;text-align:center}.founder img{margin:0 auto}}
  /* start-a-conversation modal (mirrors Vault Human hub) */
  .vh-modal{position:fixed;inset:0;z-index:2147483000;display:none}
  .vh-modal.is-open{display:block}
  .vh-modal__bg{position:absolute;inset:0;background:rgba(0,0,0,.74)}
  .vh-modal__card{position:relative;width:min(520px,92vw);margin:6.5vh auto;background:#f7f5f0;color:#14161c;border-radius:14px;padding:34px 30px 26px;max-height:86vh;overflow:auto;box-shadow:0 30px 90px rgba(0,0,0,.55);font-family:Inter,system-ui,sans-serif}
  .vh-modal__x{position:absolute;top:8px;right:14px;background:none;border:0;font-size:30px;line-height:1;color:#8a8a8a;cursor:pointer;padding:2px 8px}
  .vh-modal__x:hover{color:#14161c}
  .vh-modal__title{margin:0 0 6px;font-family:Fraunces,Georgia,serif;font-weight:400;font-size:26px;color:#14161c}
  .vh-modal__sub{margin:0 0 18px;color:#565656;font-size:15px;line-height:1.45}
  .vh-modal .hs-form-frame label,.vh-modal .hs-form-frame legend,.vh-modal .hs-form-frame p,.vh-modal .hs-form-frame span,.vh-modal .hs-form-frame h1,.vh-modal .hs-form-frame h2,.vh-modal .hs-form-frame h3{color:#14161c !important}
  .vh-modal .hs-form-frame input,.vh-modal .hs-form-frame textarea,.vh-modal .hs-form-frame select{color:#14161c !important;background:#fff !important;border:1px solid #c9c4bb !important}
  @media(max-width:560px){.vh-modal__card{width:100vw;min-height:100vh;margin:0;border-radius:0}}

  /* national band */
  .national{text-align:center;padding:56px 0;background:linear-gradient(180deg,var(--bg),var(--panel))}
  .national .mono{color:var(--accent);font-size:.8rem}
  .national h2{margin:12px 0}
  .national p{color:var(--muted);max-width:56ch;margin:0 auto}

  /* final */
  .final-grid{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start}
  form{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:28px}
  form label{display:block;font-family:'JetBrains Mono';font-size:.72rem;color:var(--muted);margin-bottom:6px;letter-spacing:.04em}
  form input,form select,form textarea{width:100%;padding:12px 14px;margin-bottom:15px;border-radius:6px;border:1px solid var(--line);background:var(--bg);color:var(--text);font-family:inherit;font-size:.94rem}
  form input:focus,form select:focus,form textarea:focus{outline:none;border-color:var(--accent)}
  form .btn-primary{width:100%;border:none}
  .disclaimer{font-size:.72rem;color:var(--dim);margin-top:12px}
  @media(max-width:820px){.final-grid{grid-template-columns:1fr;gap:30px}}

  footer{background:#08090C;border-top:1px solid var(--line);padding:48px 0 28px;color:var(--muted);font-size:.86rem}
  .foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:34px;margin-bottom:30px}
  footer .brand{color:var(--text);margin-bottom:12px;font-size:1.2rem}
  footer h5{color:var(--text);font-family:'JetBrains Mono';font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;margin-bottom:12px}
  footer ul{list-style:none;display:flex;flex-direction:column;gap:8px}
  footer a:hover{color:var(--accent)}
  .endorse{font-family:'JetBrains Mono';font-size:.78rem;color:var(--dim)}
  .legal{border-top:1px solid var(--line);padding-top:20px;font-size:.74rem;color:var(--dim)}
  @media(max-width:720px){.foot-grid{grid-template-columns:1fr}}
.navlinks a.btn-primary{color:#1a1408}
</style>
